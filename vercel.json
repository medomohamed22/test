{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).(css|js|svg|webp|png|jpg|jpeg)",
      "headers": [{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server?__path=:path*"
    }
  ]
}
